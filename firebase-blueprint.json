{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user's role session binding verified against an Admin-issued AuthTicket. Clients submit FieldValue.serverTimestamp() for createdAt and updatedAt.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Portal user display name" },
        "role": { "type": "string", "enum": ["ADMIN", "TEACHER", "PARENT"] },
        "ticketHash": { "type": "string", "description": "64-char SHA-256 hex credential ticket hash" },
        "academyId": { "type": "string", "description": "Academy identifier" },
        "teacherId": { "type": "string", "description": "Linked Teacher ID when role is TEACHER" },
        "assignedClassIds": { "type": "array", "description": "Bounded list of assigned class IDs" },
        "linkedStudentIds": { "type": "array", "description": "Bounded list of linked student IDs" },
        "createdAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "displayName", "role", "ticketHash", "academyId", "teacherId", "assignedClassIds", "linkedStudentIds", "createdAt", "updatedAt"]
    },
    "AcademyDirectory": {
